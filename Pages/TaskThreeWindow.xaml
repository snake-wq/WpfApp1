<Window x:Class="WpfVariantApp.TaskThreeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задача 3"
        Height="440"
        Width="750"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="16"
                   TextWrapping="Wrap"
                   Text="Задача 3. Дан массив координат N точек на прямой. Найти точку, сумма расстояний от которой до остальных точек минимальна, и саму сумму."/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Введите координаты точек через пробел:"/>

            <TextBox x:Name="txtPointCoordinates"
                     Height="35"
                     Margin="0,5,0,0"
                     FontSize="16"/>

            <TextBlock Margin="0,5,0,0"
                       Foreground="Gray"
                       Text="Пример: 5 -2 10 0 -7 3"/>
        </StackPanel>

        <Button x:Name="btnFindMinimumDistance"
                Grid.Row="4"
                Content="Найти точку"
                Width="170"
                Height="35"
                HorizontalAlignment="Left"
                Click="BtnFindMinimumDistance_Click"/>

        <StackPanel Grid.Row="6">
            <TextBlock Text="Результат:"/>

            <TextBox x:Name="txtMinimumDistanceResult"
                     Height="65"
                     Margin="0,5,0,0"
                     FontSize="16"
                     TextWrapping="Wrap"
                     IsReadOnly="True"/>
        </StackPanel>

        <Button x:Name="btnClosePage"
                Grid.Row="7"
                Content="Закрыть"
                Width="100"
                Height="30"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Click="BtnClosePage_Click"/>
    </Grid>
</Window>