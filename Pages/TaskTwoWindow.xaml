<Window x:Class="WpfVariantApp.TaskTwoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задача 2"
        Height="410"
        Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="16"
                   TextWrapping="Wrap"
                   Text="Задача 2. Дана строка, состоящая из русских слов, разделённых одним или несколькими пробелами. Определить длину самого длинного слова."/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Введите строку со словами:"/>

            <TextBox x:Name="txtInputSentence"
                     Height="70"
                     Margin="0,5,0,0"
                     FontSize="16"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <Button x:Name="btnFindLongestWord"
                Grid.Row="4"
                Content="Найти длину"
                Width="170"
                Height="35"
                HorizontalAlignment="Left"
                Click="BtnFindLongestWord_Click"/>

        <StackPanel Grid.Row="6">
            <TextBlock Text="Результат:"/>

            <TextBox x:Name="txtLongestWordLength"
                     Height="35"
                     Margin="0,5,0,0"
                     FontSize="16"
                     IsReadOnly="True"/>
        </StackPanel>

        <Button x:Name="btnClosePage"
                Grid.Row="7"
                Content="Закрыть"
                Width="100"
                Height="30"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Click="BtnClosePage_Click"/>
    </Grid>
</Window>